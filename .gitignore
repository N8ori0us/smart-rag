# Python System & Dependency Caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.pyc
*.pyo
*.pyd

# Exclude local knowledge documents and runtime session history saves
backend/data/*
!backend/data/.gitkeep
backend/app/*.json
*.json

# Exclude sensitive environment configurations
.env
backend/.env
data/
backend/data/

# macOS System & Desktop Metadata
.DS_Store
mac-manager/.xcworkspace/
mac-manager/.xcuserdata/
.AppleDouble
.LSOverride
._*

# Visual Studio Code & IDE Workspaces
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
.vscode/settings.json



# Runtime Logs and Caches
*.log
.cache/
